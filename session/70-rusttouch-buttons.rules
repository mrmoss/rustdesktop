# Installed to /etc/udev/rules.d/70-rusttouch-buttons.rules
# Give the person at the device (the user logged in at the seat, nobody else)
# access to *button* devices (power, volume, brightness, tablet button arrays)
# - never full keyboards - so RustTouch can handle short/long/double power
# presses and hold-to-repeat volume. ("uaccess" can only give read and write
# together; read-only for everyone would let other accounts and services read
# them too, which is worse.)
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEY}=="1", ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Power Button", TAG+="uaccess"
