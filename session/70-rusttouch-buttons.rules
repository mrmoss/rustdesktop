# Installed to /etc/udev/rules.d/70-rusttouch-buttons.rules
# Give the person at the device (the user logged in at the seat, nobody else)
# access to *button* devices (power, volume, brightness, tablet button arrays)
# - never full keyboards - so RustTouch can handle short/long/double power
# presses and hold-to-repeat volume. ("uaccess" can only give read and write
# together; read-only for everyone would let other accounts and services read
# them too, which is worse.)
# Only the machine's own buttons: not USB or Bluetooth ones (a numeric
# keypad, a remote, a macro pad - what's typed on those stays private too).
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEY}=="1", ENV{ID_INPUT_KEYBOARD}!="1", ENV{ID_BUS}!="usb", ENV{ID_BUS}!="bluetooth", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Power Button", TAG+="uaccess"
# Mice and touchpads: RustTouch only looks at their button presses, so that
# clicking with a mouse can put the on-screen keyboard away. Not a device that
# is a keyboard (or has keys) too - a keyboard with a touchpad built in, a mouse
# with macro keys: its keystrokes (passwords) must stay private.
# (Known: uaccess gives read *and* write - a program of the person at the
# device could send clicks through these. Only the logged-in person's own
# programs: the same as any desktop's input access.)
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT_TOUCHSCREEN}!="1", ENV{ID_INPUT_TABLET}!="1", ENV{ID_INPUT_KEYBOARD}!="1", ENV{ID_INPUT_KEY}!="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHPAD}=="1", ENV{ID_INPUT_KEYBOARD}!="1", ENV{ID_INPUT_KEY}!="1", TAG+="uaccess"
