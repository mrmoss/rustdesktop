<?xml version="1.0"?>
<!-- Minimal labwc config for rusttouch: no decorations, every app maximized. -->
<labwc_config>
  <core>
    <gap>0</gap>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <windowRules>
    <!-- phone-style: apps fill the space between the bars, no title bars -->
    <windowRule identifier="*" serverDecoration="no">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>

  <keyboard>
    <default/>
    <keybind key="W-Return"><action name="Execute" command="x-terminal-emulator"/></keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>

  <mouse>
    <default/>
  </mouse>

  <!--
    If touches land in the wrong place (multi-monitor or after rotating),
    map the touchscreen to its output. Find names with `libinput list-devices`
    and `wlr-randr`:
    <touch deviceName="ELAN Touchscreen" mapToOutput="eDP-1" mouseEmulation="no"/>
  -->
</labwc_config>
