<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RustTV</vendor>
  <action id="dev.rusttv.autologin.disable">
    <description>Turn off logging in by itself into RustTV, for your own account</description>
    <message>RustTV wants to turn off logging you in by itself</message>
    <!-- Only turning it OFF, which only makes things stricter: the person at
         the TV (the active local session) may, without a password. Turning
         it ON takes an administrator's password (RustTV runs the helper
         through sudo for that), and the helper refuses "enable" through
         pkexec. -->
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/rusttv-autologin</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">disable</annotate>
  </action>
</policyconfig>
