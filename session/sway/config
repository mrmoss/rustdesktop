# sway config for RustTouch (split screen). The shell draws the bars, home
# screen and handles; sway only places windows. Your own additions:
# ~/.config/rusttouch/sway.conf (included at the end).

# no title bars or borders; a thin black gap only between split apps
default_border none
default_floating_border normal 2
hide_edge_borders --i3 smart
smart_gaps on
gaps inner 4
gaps outer 0
font pango:sans 10

# touch-first behaviour
focus_follows_mouse no
mouse_warping none
focus_on_window_activation focus
seat * hide_cursor 4000
workspace_layout default
default_orientation auto

# dialogs float over their app
for_window [window_type="dialog"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_role="pop-up"] floating enable
# mirrored screens (display_mode = mirror)
for_window [app_id="at.yrlf.wl_mirror"] fullscreen enable

# behind everything: RustTouch draws the wallpaper itself
output * bg #000000 solid_color

xwayland enable

# a few keys for a keyboard/mouse
floating_modifier Mod4 normal
bindsym Mod4+Return exec foot
bindsym Mod4+q kill
bindsym Mod4+f fullscreen toggle
bindsym Mod4+Left focus left
bindsym Mod4+Right focus right
bindsym Mod4+Up focus up
bindsym Mod4+Down focus down

# Ubuntu: hand the session environment to systemd/D-Bus (portals)
include /etc/sway/config.d/*

exec /usr/local/bin/rusttouch-shell
